---
# ============================================================
# .clangd
# Hardcore C++23 / Header-Only Library
# ============================================================

CompileFlags:
  # ----------------------------------------------------------
  # Compilation database
  # ----------------------------------------------------------

  CompilationDatabase: build

  # ----------------------------------------------------------
  # Only add things that are genuinely required by clangd.
  #
  # Do NOT duplicate warnings here. CMake owns those.
  # ----------------------------------------------------------

  Add:
    - -std=c++23
    - -I.
    - -march=native

    # Unlimited diagnostic expansion.
    - -ftemplate-backtrace-limit=0
    - -fconstexpr-backtrace-limit=0
    - -fmacro-backtrace-limit=0
    - -ferror-limit=0

  Remove:
    # Do not let stale/incompatible warning flags from the
    # compilation database break clangd.
    #
    # IMPORTANT:
    # We deliberately DO NOT remove every -W flag because
    # CMake is now the single source of truth for diagnostics.
    - -fno-lifetime-dse
    - -fvar-tracking*
    - -fsanitize*


# ============================================================
# Index
# ============================================================

Index:
  Background: Build
  StandardLibrary: Yes

# ============================================================
# Completion
# ============================================================

Completion:
  AllScopes: Yes
  HeaderInsertion: IWYU
  ArgumentLists: FullPlaceholders

# ============================================================
# Diagnostics
# ============================================================

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

  Suppress:
    - unknown_argument

# ============================================================
# Inlay hints
# ============================================================

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes
  BlockEnd: Yes
  DefaultArguments: Yes
  TypeNameLimit: 0

...
